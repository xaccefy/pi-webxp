{
  "name": "@xaccefy/pi-webxp",
  "version": "0.11.0",
  "description": "Web search, page fetch, and documentation tools for Pi Agent",
  "keywords": [
    "pi-package",
    "pi-extension",
    "xpi",
    "web-search",
    "lookup",
    "documentation"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xaccefy/pi-webxp.git"
  },
  "homepage": "https://github.com/xaccefy/pi-webxp#readme",
  "bugs": {
    "url": "https://github.com/xaccefy/pi-webxp/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "src/index.ts",
    "src/websearch.ts",
    "src/network-safety.ts",
    "src/context7.ts",
    "src/deepwiki.ts",
    "README.md",
    "LICENSE"
  ],
  "main": "src/index.ts",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "dependencies": {
    "@xaccefy/pi-shared": "0.9.4",
    "open-websearch": "^2.1.11"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "scripts": {
    "test": "bun test --isolate",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check . --write"
  }
}
